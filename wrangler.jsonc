{
  // Static site served by a Cloudflare Worker (assets only, no server code).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server-rack-builder",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "rackbuilder.privatecomputesystems.com", "custom_domain": true }
  ]
}
